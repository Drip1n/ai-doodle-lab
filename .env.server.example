# Server settings. Copy to .env.server.local; never commit secrets.
PORT=8787
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5173
IMAGE_REQUEST_LIMIT=20
PORTKEY_BASE_URL=https://api.portkey.ai/v1
# Set the exact model/route names from your Portkey workspace.
IMAGE_MODEL=
# edits: multipart image edits; chat: image-output chat completions (route-specific).
IMAGE_OPERATION=edits
PORTKEY_CONFIG_ID=
PORTKEY_VIRTUAL_KEY=
# Secrets: leave empty until you configure your own account.
PORTKEY_API_KEY=
WORKSHOP_ACCESS_CODE=
PORTKEY_PROVIDER=
