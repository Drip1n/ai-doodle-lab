# Server settings. Copy to .env.server.local; never commit secrets.
# Everything here is server-only. Nothing in this file belongs in a VITE_*
# variable: those are compiled into the public frontend bundle.

# --- Network ---------------------------------------------------------------
PORT=8787
HOST=127.0.0.1
# The exact origin of the website, scheme and port included. Any request with
# a different Origin header is refused, and admin POSTs require a match.
APP_ORIGIN=http://127.0.0.1:5173
# Set to 1 only when a reverse proxy sits in front, so the left-most
# X-Forwarded-For entry is used for sign-in lockout counting. Leave unset for
# a direct connection: trusting the header without a proxy lets a client
# forge its own address.
TRUST_PROXY=
# Cookies are Secure automatically when APP_ORIGIN is https. 1 forces it on,
# 0 off (local http development only).
ADMIN_COOKIE_SECURE=

# --- Image provider (Portkey) ----------------------------------------------
PORTKEY_BASE_URL=https://api.portkey.ai/v1
# Set the exact model/route names from your Portkey workspace.
IMAGE_MODEL=
# edits: multipart image edits; chat: image-output chat completions (route-specific).
IMAGE_OPERATION=edits
# Sent with IMAGE_OPERATION=edits only; chat completions has no such parameters.
# A value outside these lists stops the server at boot rather than reaching the
# provider, so a typo cannot quietly change what you are billed for.
# IMAGE_QUALITY: auto, low, medium, high                 (default medium)
# IMAGE_SIZE:    auto, 1024x1024, 1536x1024, 1024x1536   (default 1024x1024)
IMAGE_QUALITY=medium
IMAGE_SIZE=1024x1024
PORTKEY_CONFIG_ID=
PORTKEY_VIRTUAL_KEY=
# Secrets: leave empty until you configure your own account.
PORTKEY_API_KEY=
PORTKEY_PROVIDER=

# --- Concurrency and queueing ----------------------------------------------
# About fifteen students share four provider calls; the rest wait in a bounded
# queue. Raise concurrency only if your provider plan is happy with it.
IMAGE_MAX_CONCURRENCY=4
IMAGE_QUEUE_LIMIT=20
IMAGE_QUEUE_WAIT_MS=120000
# The provider clock starts when a request leaves the queue, so queueing never
# eats into generation time.
IMAGE_PROVIDER_TIMEOUT_MS=90000

# --- Cost and abuse ceilings ------------------------------------------------
# Emergency ceiling for the whole server process, on top of per-code limits.
# Blank uses the default of 200; 0 turns it off. It resets on restart, so a
# provider-side spending cap is still the authoritative budget.
IMAGE_GLOBAL_REQUEST_LIMIT=200
# Burst ceiling per workshop code. 30 per minute leaves a class of fifteen
# plenty of room while stopping a script.
IMAGE_CODE_RATE_LIMIT=30
IMAGE_CODE_RATE_WINDOW_MS=60000

# --- Phone handoff (the QR code under a finished picture) -------------------
# After a picture is made, one copy is held IN MEMORY ONLY behind a random
# expiring token so a child's phone can fetch it. Nothing is written to disk,
# and every link dies when this process restarts.
# How long a QR link works, in milliseconds (60000 - 21600000).
IMAGE_SHARE_TTL_MS=1800000
# How many pictures may be held at once (0 - 500). 0 switches sharing off.
# There is also a fixed ceiling of 8 MB per picture and 64 MB in total.
IMAGE_SHARE_MAX_ITEMS=40

# --- Workshop codes ---------------------------------------------------------
# Where the code store lives. Server-side only, gitignored, never served as a
# static asset. Created on first use.
WORKSHOP_STORE_PATH=server/.data/workshop-codes.json
# The readable part of every generated code, e.g. FONTYS-A7K2M9PQ.
WORKSHOP_CODE_PREFIX=FONTYS

# --- Admin panel -----------------------------------------------------------
# Generate each hash with:  npm run admin:hash-password -- you@example.com
# Single quotes matter: the scrypt hash contains $ characters.
# Plaintext passwords must never appear here or in Git.
# ADMIN_USERS_JSON='[{"email":"teacher@example.com","passwordHash":"scrypt$16384$8$1$REPLACE_SALT$REPLACE_HASH"}]'
ADMIN_USERS_JSON=
ADMIN_SESSION_TTL_MS=28800000
ADMIN_MAX_FAILURES=5
ADMIN_LOCKOUT_MS=900000
