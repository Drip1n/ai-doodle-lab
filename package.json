{
  "name": "ai-doodle-lab",
  "private": true,
  "version": "1.0.0",
  "description": "A kid-friendly browser-based machine learning workshop where students teach an AI to recognize their own drawings.",
  "type": "module",
  "scripts": {
    "server": "node --env-file-if-exists=.env.server.local server/index.mjs",
    "test:server": "node --test server/*.test.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:canvas": "playwright test --project=canvas-desktop-chromium --project=canvas-mobile-chromium --project=canvas-mobile-webkit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tensorflow-models/knn-classifier": "^1.2.6",
    "@tensorflow-models/mobilenet": "^2.1.1",
    "@tensorflow/tfjs": "^4.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  }
}
