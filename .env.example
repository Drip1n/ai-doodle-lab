# Public frontend settings only. Never put API keys, admin passwords or
# workshop codes in VITE_* variables: they are compiled into the public bundle.
# Copy to .env.local. Demo works without any server or key.
VITE_IMAGE_MODE=demo
# Live requires YOUR server function, not the Portkey/provider URL.
VITE_IMAGE_ENDPOINT=
# Optional. Defaults to VITE_IMAGE_ENDPOINT without the trailing
# /generate-image, which is right whenever both run on the same server.
VITE_ADMIN_ENDPOINT=
